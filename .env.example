# Hackerspace Visual Inventory Locator Configuration Template

# Admin password required to upload new shelf photos (temporary prototype security control)
ADMIN_PASSWORD=change_this_password

# Gemini API Key for vision ingestion (optional: mock bounding boxes are used if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Data directory for persistent storage (SQLite and images)
DATA_DIR=./data
PORT=8000
