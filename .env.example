# Google Gemini API key for vision-based bin detection, label OCR, and semantic tagging
GEMINI_API_KEY=

# Optional Gemini model override (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Path to the data directory (SQLite db, images, seed photos)
DATA_DIR=./data

# Server Port
PORT=8000
